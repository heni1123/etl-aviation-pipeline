{
  "task": "Generate pipeline_config.json with sources, target, settings",
  "sources": [
    {
      "id": "src_opensky_states",
      "url": "https://opensky-network.org/api/states/all",
      "method": "GET",
      "params": {
        "lamin": "28.0",
        "lomin": "-10.0",
        "lamax": "47.0",
        "lomax": "37.0"
      }
    },
    {
      "id": "src_adsbdb_callsign",
      "url": "https://api.adsbdb.com/v0/callsign/{callsign}",
      "method": "GET",
      "params": {
        "callsign": "callsign"
      }
    },
    {
      "id": "src_rest_countries",
      "url": "https://restcountries.com/v3.1/alpha/{code}",
      "method": "GET",
      "params": {
        "code": "ISO code"
      }
    }
  ],
  "target": {
    "schema": "analytics",
    "table": "cible",
    "load_strategy": "truncate_insert"
  },
  "env_vars": [
    "GITHUB_OWNER",
    "DB_HOST",
    "DB_PORT",
    "DB_USER",
    "DB_PASSWORD",
    "DB_NAME",
    "GITHUB_REPO",
    "GITHUB_TOKEN"
  ],
  "rules": [
    "All credentials must reference env vars, never hardcoded values"
  ]
}