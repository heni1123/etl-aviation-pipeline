DB_NAME=your_value_here  # Database name for the target PostgreSQL database
DB_USER=your_value_here  # Username for the database connection
DB_HOST=your_value_here  # Host address for the database
DB_PASSWORD=your_value_here  # Password for the database user
DB_PORT=your_value_here  # Port number for the database connection
GITHUB_OWNER=your_value_here  # GitHub owner for the repository
GITHUB_TOKEN=your_value_here  # GitHub token for authentication
GITHUB_REPO=your_value_here  # GitHub repository name