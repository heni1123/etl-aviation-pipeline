DB_PASSWORD=your_value_here  # Database password for connecting to PostgreSQL
GITHUB_TOKEN=your_value_here  # GitHub personal access token for API access
DB_PORT=your_value_here  # Port number for PostgreSQL database connection
GITHUB_OWNER=your_value_here  # GitHub repository owner
DB_USER=your_value_here  # Database username for connecting to PostgreSQL
DB_HOST=your_value_here  # Hostname or IP address of the PostgreSQL database
GITHUB_REPO=your_value_here  # GitHub repository name
DB_NAME=your_value_here  # Name of the target PostgreSQL database