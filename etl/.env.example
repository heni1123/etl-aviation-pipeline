DB_NAME=your_value_here  # Database name for the target PostgreSQL database
DB_PORT=your_value_here  # Port number for the PostgreSQL database
DB_USER=your_value_here  # Username for connecting to the PostgreSQL database
DB_HOST=your_value_here  # Host address for the PostgreSQL database
GITHUB_OWNER=your_value_here  # GitHub owner for the repository
GITHUB_TOKEN=your_value_here  # GitHub token for authentication
DB_PASSWORD=your_value_here  # Password for the PostgreSQL database user
GITHUB_REPO=your_value_here  # GitHub repository name