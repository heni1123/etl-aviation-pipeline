DB_PASSWORD=your_value_here  # Database password for connecting to PostgreSQL
DB_NAME=your_value_here       # Name of the target database (analytics.cible)
DB_USER=your_value_here       # Database user for authentication
DB_HOST=your_value_here       # Host address of the PostgreSQL server
DB_PORT=your_value_here       # Port number for PostgreSQL (default is 5432)
GITHUB_OWNER=your_value_here  # GitHub owner for repository access
GITHUB_REPO=your_value_here    # GitHub repository name
GITHUB_TOKEN=your_value_here   # GitHub personal access token for API authentication